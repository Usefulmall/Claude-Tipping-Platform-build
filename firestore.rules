rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // True when the signed-in person's account record says they are an admin.
    function isAdmin() {
      return isSignedIn() &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'name', 'role', 'createdAt']) &&
             data.uid is string &&
             data.email is string &&
             data.name is string &&
             data.role in ['admin', 'employer', 'worker'] &&
             data.createdAt is string;
    }

    function isValidWorker(data) {
      return data.keys().hasAll(['id', 'employerId', 'name', 'position', 'phone', 'createdAt']) &&
             data.id is string &&
             data.employerId is string &&
             data.name is string && data.name.size() <= 100 &&
             data.position is string &&
             data.phone is string && data.phone.size() >= 9 &&
             // 'bank' is the text after the @ in the ShapID. Optional so workers
             // registered before it existed keep working; the forms require it.
             (!('bank' in data) || (data.bank is string && data.bank.size() >= 2 && data.bank.size() <= 30)) &&
             data.createdAt is string;
    }

    // Tips are always a self-report by the tipper (TipMe never processes the
    // payment), written once and never updated — there is no webhook to
    // confirm or change a tip's status after the fact.
    function isValidTip(data) {
      return data.keys().hasAll(['id', 'workerId', 'workerName', 'employerId', 'amount', 'status', 'createdAt']) &&
             data.keys().size() <= 7 &&
             data.id is string &&
             data.workerId is string &&
             data.workerName is string && data.workerName.size() <= 100 &&
             data.employerId is string &&
             data.amount is number && data.amount > 0 &&
             data.status == 'reported' &&
             data.createdAt is string && data.createdAt.size() <= 50;
    }

    // ─── Users ────────────────────────────────────────────────────────────────
    match /users/{userId} {
      // The app only ever reads a person's own account record.
      allow read: if isSignedIn() && request.auth.uid == userId;
      // Public sign-up can only create employer or worker accounts, never admin.
      allow create: if isSignedIn() && request.auth.uid == userId && isValidUser(incoming()) &&
                    incoming().role in ['employer', 'worker'];
      allow update: if isSignedIn() && request.auth.uid == userId &&
                    isValidUser(incoming()) &&
                    incoming().uid == existing().uid &&
                    incoming().role == existing().role &&
                    incoming().email == existing().email &&
                    incoming().createdAt == existing().createdAt;
      allow delete: if false;
    }

    // ─── Workers ──────────────────────────────────────────────────────────────
    match /workers/{workerId} {
      // Anyone may look up ONE worker by their id (the tip page needs this when
      // a customer scans a QR code). Listing workers is not public: an employer
      // may list only their own workers, and an admin may list everyone.
      allow get: if true;
      allow list: if isSignedIn() &&
                  (isAdmin() || resource.data.employerId == request.auth.uid);
      allow create: if isValidWorker(incoming());
      allow update: if isSignedIn() &&
                    isValidWorker(incoming()) &&
                    incoming().id == existing().id &&
                    incoming().employerId == existing().employerId &&
                    incoming().createdAt == existing().createdAt;
      allow delete: if isSignedIn();
    }

    // ─── Tips ─────────────────────────────────────────────────────────────────
    // Self-reported only: written once by the tipper, never updated afterwards.
    match /tips/{tipId} {
      allow read: if true;
      allow create: if isValidTip(incoming());
      allow update: if false;
      allow delete: if false;
    }
  }
}
