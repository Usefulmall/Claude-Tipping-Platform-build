rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'name', 'role', 'createdAt']) &&
             data.uid is string &&
             data.email is string &&
             data.name is string &&
             data.role in ['admin', 'employer'] &&
             data.createdAt is string;
    }

    function isValidWorker(data) {
      return data.keys().hasAll(['id', 'employerId', 'name', 'position', 'phone', 'createdAt']) &&
             data.id is string &&
             data.employerId is string &&
             data.name is string && data.name.size() <= 100 &&
             data.position is string &&
             data.phone is string && data.phone.size() >= 9 &&
             data.createdAt is string;
    }

    function isValidTip(data) {
      return data.keys().hasAll(['id', 'workerId', 'workerName', 'employerId', 'amount', 'feeAmount', 'workerAmount', 'status', 'reference', 'customerEmail', 'createdAt']) &&
             data.keys().size() <= 13 &&
             data.id is string &&
             data.workerId is string &&
             data.workerName is string && data.workerName.size() <= 100 &&
             data.employerId is string &&
             data.amount is number && data.amount > 0 &&
             data.feeAmount is number &&
             data.workerAmount is number &&
             data.status in ['pending', 'success', 'failed'] &&
             data.reference is string &&
             data.customerEmail is string && data.customerEmail.size() <= 128 &&
             data.createdAt is string && data.createdAt.size() <= 50 &&
             (!data.keys().hasAll(['customerName']) || (data.customerName is string && data.customerName.size() <= 100));
    }

    // ─── Users ────────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId && isValidUser(incoming()) && incoming().createdAt is string;
      allow update: if isSignedIn() && request.auth.uid == userId &&
                    isValidUser(incoming()) &&
                    incoming().uid == existing().uid &&
                    incoming().email == existing().email &&
                    incoming().createdAt == existing().createdAt;
      allow delete: if false;
    }

    // ─── Workers ──────────────────────────────────────────────────────────────
    match /workers/{workerId} {
      allow read: if true;
      allow create: if isValidWorker(incoming());
      allow update: if isSignedIn() &&
                    isValidWorker(incoming()) &&
                    incoming().id == existing().id &&
                    incoming().employerId == existing().employerId &&
                    incoming().createdAt == existing().createdAt;
      allow delete: if isSignedIn();
    }

    // ─── Tips ─────────────────────────────────────────────────────────────────
    match /tips/{tipId} {
      allow read: if isSignedIn() || true;
      allow create: if isValidTip(incoming()) && incoming().status == 'pending';
      allow update: if isValidTip(incoming()) &&
                    incoming().id == existing().id &&
                    incoming().workerId == existing().workerId &&
                    incoming().employerId == existing().employerId &&
                    incoming().amount == existing().amount &&
                    incoming().createdAt == existing().createdAt;
      allow delete: if false;
    }
  }
}
